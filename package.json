{
  "name": "rotating-domains-checker",
  "version": "1.1.20",
  "description": "GitHub Action for checking and updating rotating domains in ad blocking filters",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run sync-version && ncc build src/index.ts -o dist",
    "prod_live": "tsx src/index.ts --mode=prod_live",
    "prod_dry": "tsx src/index.ts --mode=prod_dry",
    "test_live": "tsx src/index.ts --mode=test_live",
    "test_dry": "tsx src/index.ts --mode=test_dry",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "new:branch": "tsx scripts/new-branch.ts",
    "sync-version": "node sync-version.js",
    "version-sync": "npm run sync-version && git add package.json",
    "prepare": "husky"
  },
  "keywords": [
    "adguard",
    "redirect-domain-tracking",
    "redirect-monitor"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "table": "^6.8.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.19.0",
    "@eslint/object-schema": "^2.1.4",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.40",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
